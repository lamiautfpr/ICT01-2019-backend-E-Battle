{
  "name": "tests",
  "version": "1.0.0",
  "devDependencies": {
    "dotenv": "^16.6.1",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.7.0",
    "prettier": "2.8.1",
    "supertest": "^6.3.4"
  },
  "scripts": {
    "test": "jest tests/integration/*",
    "format": "prettier --write src/**/*.js",
    "lint:check": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 4
  }
}
